---
import Layout from "../layouts/Layout.astro";
import Section from "@/components/surfaces/Section.astro";
import SectionHeader from "@/components/surfaces/SectionHeader.astro";
import { Image } from "astro:assets";
import about from "../assets/images/aboutpic.jpg";
import Card from "@/components/surfaces/Card.astro";
---

<Layout title="About" description="Learn more about me.">
  <Section
    id="about"
    title="ABOUT.HTML"
    subtitle="The Webmaster"
    meta="[PERSONAL]"
  >
    <p>
      I’m a nerd who has been building and breaking websites since I was a kid
      in the early 2000s. I wrote my first lines of HTML and CSS code to
      customize my MySpace profile, and that planted the coding bug in me at an
      early age. Discovering the indie web and neocities has healed something in
      my developer heart.
    </p>

    <div class="details">
      <Card variant="inset">
        <SectionHeader size="sm" icon="📟" title="DETAILS" />
        <Image src={about} alt="Me" class="image" />
        <ul>
          <li>my name is jess and my pronouns are she/her;</li>
          <li>I was born in 1994 on June 4th;</li>
          <li>
            Yes, I'm a gemini, but please don't hold that against me!
            #NotAllGemini;
          </li>
          <li>I'm portuguese;</li>
          <li>I'm a cis lesbian;</li>
          <li>
            I'm an introvert and quite shy when meeting new people (even
            online), but once I'm comfortable with someone I love to hang out
            and talk;
          </li>
          <li>I have 2 cats, 1 dog and 1 goat;</li>
          <li>
            Main hobbies: gaming, drawing & painting, reading, watching movies,
            watching women's basketball, coding
          </li>
        </ul>
      </Card>
    </div>
  </Section>
</Layout>

<style>
  .image {
    border: 1px solid var(--border);
    padding: 4px;
  }

  .details {
    display: grid;
    grid-template-columns: 1fr;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--text-sm);
  }

  @media (max-width: 800px) {
    .details {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
