---
import Layout from "../layouts/Layout.astro";

import { Image } from "astro:assets";
import honestwork from "../assets/images/honestwork.jpg";
import alienPointing from "../assets/gifs/alienpointing.gif";
import Section from "@/components/surfaces/Section.astro";
---

<Layout>
  <Section
    id="home"
    title="HOME.HTML"
    subtitle="Welcome to my site!"
    meta="[INTRO]"
  >
    <p>
      Hi, I'm Jess! Welcome to my home on the world wide web! I'm an independent
      web designer and developer, and this is my place to showcase my work and
      share more about me!
    </p>
    <Image
      src={honestwork}
      alt="It ain't much but it's honest work"
      class="image"
    />

    <Image src={alienPointing} alt="Alien Pointing Up" />
  </Section>
</Layout>

<style>
  .image {
    max-width: 300px;
    width: 100%;
    height: auto;
  }
</style>