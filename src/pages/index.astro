---
import Layout from "../layouts/Layout.astro";

import { Image } from "astro:assets";
import honestwork from "../assets/images/honestwork.jpg";
import Section from "@/components/surfaces/Section.astro";
import Card from "@/components/surfaces/Card.astro";
import SectionHeader from "@/components/surfaces/SectionHeader.astro";
import Callout from "@/components/surfaces/Callout.astro";
---

<Layout>
  <Section
    id="home"
    title="HOME.HTML"
    subtitle="Welcome to my site!"
    meta="[INTRO]"
  >
    <p>
      Hi, I'm Jess! Welcome to my home on the world wide web! I'm an independent
      web designer and developer, and this is my place to showcase my work and
      share more about me!
    </p>
    <marquee><Image
      src={honestwork}
      alt="It ain't much but it's honest work"
      class="image"
    /></marquee>

    <Card variant="inset">
      <SectionHeader title="// CHANGELOG" size="sm" meta="SITE UPDATES"/>
      <Callout variant="info" title="REDESIGN TO A TERMINAL STYLE">SEPTEMBER 28TH, 2026</Callout>
      <Callout variant="success" icon="✓" title="WEBSITE LAUNCHED!:D">SEPTEMBER 18TH, 2026</Callout>
    </Card>
  </Section>
</Layout>

<style>
  .image {
    max-width: 300px;
    width: 100%;
    height: auto;
  }
</style>