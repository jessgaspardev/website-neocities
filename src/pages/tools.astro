---
import Layout from "../layouts/Layout.astro";
import Section from "@/components/surfaces/Section.astro";
import Card from "@/components/surfaces/Card.astro";
import SectionHeader from "@/components/surfaces/SectionHeader.astro";
import Badge from "@/components/feedback/Badge.astro";
---

<Layout
  title="Tools"
  description="List of software I use daily."
>
  <Section id="tools" title="TOOLS.JS" subtitle="Tools I use" meta="[LIST]">
    <p>
      This is a list of hardware and software I like to use in my day to day,
      either for work and personal use.
    </p>

    <Card variant="inset">
      <SectionHeader size="sm" title="// SETUP" />
      <ul>
        <li>
          <Badge variant="outline">[Laptop]</Badge> HP OMEN 15 AMD Ryzen 7 <span
            >// I would like to upgrade soon when I have money for it;</span>
        </li>
        <li>
          <Badge variant="outline">[Operating System]</Badge> Linux Mint - Cinnamon
          // <span>It's so awesome;</span>
        </li>
        <li>
          <Badge variant="outline">[Mechanical Keyboard]</Badge> Ajazz AK820 Pro <span
            >// I love typing click clickly click clack;</span>
        </li>
      </ul>
    </Card>

    <Card variant="inset">
      <SectionHeader size="sm" title="// CODING" />
      <ul>
        <li>
          <Badge variant="outline">[IDE]</Badge> Visual Studio Code <span
            >// If it ain't broken don't fix it;</span>
        </li>
        <li>
          <Badge variant="outline">[Hosting]</Badge> Cloudflare Pages <span
            >// Where I host all my static websites (except this one which is
            hosted on Neocities :D);</span>
        </li>
        <li>
          <Badge variant="outline">[Framework]</Badge> Astro <span
            >The best for creating static websites of all levels of complexity;</span>
        </li>
        <li>
          <Badge variant="outline">[Framework]</Badge> Laravel <span>
            When it comes to full-stack applications, Laravel is my favorite (I
            despise the "one million dependencies to make it work" that
            JavaScript-based full stacks require. PHP 4ever);</span>
        </li>
      </ul>
    </Card>

    <Card variant="inset">
      <SectionHeader size="sm" title="// DESIGN & ART" />
      <ul>
        <li>
          <Badge variant="outline">[Web Design]</Badge> Figma <span
            >// The only viable web design tool option nowadays unfortunately;</span>
        </li>
        <li>
          <Badge variant="outline">[Graphic Design]</Badge> Affinity Suite <span
            >// My Adobe replacement;</span>
        </li>
        <li>
          <Badge variant="outline">[Digital Art]</Badge> Krita <span
            >// Open-source art program, my favorite for digital paintings;</span>
        </li>
      </ul>
    </Card>

    <Card variant="inset">
      <SectionHeader size="sm" title="// ORGANIZATION & PLANNING" />
      <ul>
        <li>
          <Badge variant="outline">[Notes]</Badge> Obsidian <span
            >// File-based note-taking and management app. It rocks;
          </span>
        </li>
        <li>
          <Badge variant="outline">[Moodboards]</Badge> Miro <span
            >// My Adobe replacement;</span>
        </li>
      </ul>
    </Card>
  </Section>
</Layout>

<style>
  span {
    font-size: var(--text-xs);
    color: var(--fg-dim);
  }
</style>
