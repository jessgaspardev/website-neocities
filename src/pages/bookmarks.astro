---
import Layout from "../layouts/Layout.astro"
---

<Layout>
    <h1>Cool stuff I find and save</h1>
    <p>Tools</p>
    <ul>
        <li><mark>delphitools</mark> // Great resource with free web tools for image editing, colors, typography and much more; [<a href="https://delphi.tools/" target="_blank">link</a>]</li>
        <li><mark>web badges world</mark> // A resource with many website badges and you can create your own too; [<a href="https://web.badges.world/" target="_blank">link</a>]</li>
        <li><mark>petrapixel</mark> // Layout generator for indie sites; [<a href="https://petrapixel.neocities.org/coding/layout-generator" target="_blank">link</a>]</li>
        <li><mark>indie web database</mark> // A collection of websites, webrings, cliques and widgets; [<a href="https://petrapixel.neocities.org/indiewebdb/" target="_blank"><img src="https://cdn.jsdelivr.net/gh/petracoding/petrapixel.neocities.org@latest/public/assets/img/links/indiewebdb.png" alt="indie web database"></a>]</li>
        <li><mark>gifcities</mark> // A whole lot of animated gifs; [<a href="https://gifcities.org/" target="_blank">link</a>]</li>
    </ul>
    <p>Other cool websites that inspire me:</p>
    <div class="buttons-gallery">
        <a href="http://laurabarros.neocities.org"><img src="http://laurabarros.neocities.org/botao.png" border="0"></a>
        <a target="_blank" href="https://espy.world/"><img src="https://espy.world/img/button.gif" style="image-rendering: pixelated"/></a>
        <a href="https://petrapixel.neocities.org/" target="_blank"><img src="https://cdn.jsdelivr.net/gh/petracoding/petrapixel.neocities.org@latest/public/assets/img/linkback.gif" alt="petrapixel"></a>    
    </div>
    
</Layout>

<style>
    .buttons-gallery *{
        margin-right: 2px;
    }

    img:hover {
        border: 2px solid yellowgreen;
    }
</style>