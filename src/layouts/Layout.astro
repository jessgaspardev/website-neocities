---
// styling
import '../styles/global.css';
// components
import BaseHead from "../components/global/BaseHead.astro";
import Header from "../components/global/Header.astro";
import LeftSidebar from "../components/global/LeftSidebar.astro";
import RightSidebar from '../components/global/RightSidebar.astro';
import Footer from "../components/global/Footer.astro";
---

<!doctype html>
<html lang="en">
	<BaseHead />
	<body>
		<!-- The next line is a skip-to-content link for keyboard users. -->
    	<a href="#content" id="skip-to-content-link">Skip to content</a>
		<div class="layout">
			<Header />
			<LeftSidebar />
			<main id="content">
				<section>
					<slot />
				</section>
			</main>
			<RightSidebar />
			<Footer />
		</div>
	</body>
</html>


<style>
	section {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
</style>

