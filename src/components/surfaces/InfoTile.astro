---
import type { HTMLAttributes } from "astro/types";
import { mergeStyle, toneVar, type Tone } from "../../lib/tone";

interface Props extends HTMLAttributes<"div"> {
  label: string;
  value?: string;
  tone?: Tone;
}

const { label, value, tone = "bright", class: className, style, ...rest } = Astro.props;
---

<div class:list={["tile", className]} style={mergeStyle(`--_tone: ${toneVar(tone)}`, style)} {...rest}>
  <span class="tile__label">{label}</span>
  <div class="tile__value">{value}<slot /></div>
</div>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    border: 1px solid var(--border);
    background: var(--bg);
    font-family: var(--font);
  }

  .tile__label {
    color: var(--fg-dim);
    font-size: var(--text-tiny);
    font-weight: 700;
    text-transform: uppercase;
  }

  .tile__value {
    color: var(--_tone);
    font-size: var(--text-xs);
    font-weight: 700;
  }
</style>
