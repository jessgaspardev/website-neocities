---
import type { HTMLAttributes } from "astro/types";

interface Option {
  value: string;
  label: string;
}

interface Props extends Omit<HTMLAttributes<"select">, "value"> {
  options?: Option[];
  /** Selected value (server-rendered). */
  value?: string;
  compact?: boolean;
}

const { options, value, compact = false, class: className, ...rest } = Astro.props;
---

<select class:list={["select", { "select--compact": compact }, className]} {...rest}>
  {options ? options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>) : <slot />}
</select>

<style>
  .select {
    box-sizing: border-box;
    max-width: 100%;
    margin: 0;
    padding: var(--space-2) calc(var(--space-2) + 14px) var(--space-2) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    appearance: none;
    /* Chevron drawn from two gradients so it follows the theme colors */
    background:
      linear-gradient(45deg, transparent 50%, var(--fg-dim) 50%) right 12px center / 5px 5px no-repeat,
      linear-gradient(-45deg, transparent 50%, var(--fg-dim) 50%) right 7px center / 5px 5px no-repeat,
      var(--bg-card);
    color: var(--fg-bright);
    font-family: var(--font);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: border-color var(--transition);
  }

  .select--compact {
    padding: 4px calc(8px + 14px) 4px 8px;
  }

  .select:hover,
  .select:focus {
    outline: none;
    border-color: var(--border-active);
  }

  .select :global(option) {
    background: var(--bg-card);
    color: var(--fg-bright);
    font-family: var(--font);
  }

  /* Fully styled dropdown in browsers with customizable <select> */
  @supports (appearance: base-select) {
    .select,
    .select::picker(select) {
      appearance: base-select;
    }

    .select {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding-right: var(--space-2);
      background: var(--bg-card);
    }

    .select--compact {
      padding-right: 8px;
    }

    .select::picker-icon {
      content: "▾";
      color: var(--fg-dim);
      transition: rotate var(--transition);
    }

    .select:open::picker-icon {
      rotate: 180deg;
    }

    .select::picker(select) {
      margin-top: 2px;
      padding: 0;
      border: 1px solid var(--border-active);
      border-radius: var(--radius);
      background: var(--bg-card);
      box-shadow: 0 0 12px var(--glow);
    }

    .select :global(option) {
      padding: 4px 8px;
      font-size: var(--text-xs);
      cursor: pointer;
    }

    .select :global(option:hover),
    .select :global(option:focus-visible) {
      outline: none;
      background: var(--bg-card-hover);
      color: var(--fg);
    }

    .select :global(option:checked) {
      background: var(--selection-bg);
      color: var(--selection-fg);
    }

    .select :global(option::checkmark) {
      content: ">";
      color: var(--accent);
    }
  }
</style>
