---
import { Image } from "astro:assets";

import bestpc from "../../assets/blinkies/bestpc.gif";
import bookmark from "../../assets/blinkies/bookmark-this-page.gif";
import codedByHuman from "../../assets/blinkies/coded-by-a-human.png";
import responsive from "../../assets/blinkies/responsivesite.jpg";
import vscode from "../../assets/blinkies/vscode.png";
import deleteTiktok from "../../assets/blinkies/deletetiktok.webp";
