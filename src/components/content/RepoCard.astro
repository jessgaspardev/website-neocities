---
/**
 * Compact linked card for a repository (or any link with a short blurb).
 * <RepoCard name="astro-tui" href="https://github.com/…" description="…" stars={42} language="TypeScript" updated="2026-09-01" />
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  name: string;
  href: string;
  description?: string;
  stars?: number;
  language?: string;
  updated?: string;
  icon?: string;
}

const { name, href, description, stars, language, updated, icon = "📦", class: className, ...rest } = Astro.props;
---

<a class:list={["repo", className]} href={href} target="_blank" rel="noopener noreferrer" {...rest}>
  <div>
    <div class="repo__head">
      <span class="repo__name">{icon} {name}</span>
      {stars !== undefined && <span class="repo__stars">⭐ {stars}</span>}
    </div>
    {description && <p class="repo__desc">{description}</p>}
  </div>
  {
    (language || updated) && (
      <div class="repo__foot">
        {language && <span class="repo__lang">{language}</span>}
        {updated && <span class="repo__updated">Updated {updated} ↗</span>}
      </div>
    )
  }
</a>

<style>
  .repo {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--border);
    background: var(--bg);
    font-family: var(--font);
    text-decoration: none;
    transition: border-color var(--transition);
  }

  .repo:hover,
  .repo:focus-visible {
    outline: none;
    border-color: var(--accent);
  }

  .repo__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 6px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }

  .repo__name {
    overflow: hidden;
    color: var(--fg-bright);
    font-size: var(--text-xs);
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--transition);
  }

  .repo:hover .repo__name {
    color: var(--accent);
  }

  .repo__stars {
    flex-shrink: 0;
    color: var(--accent);
    font-size: var(--text-tiny);
    font-weight: 700;
  }

  .repo__desc {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--fg-dim);
    font-size: var(--text-small);
    line-height: var(--leading-tight);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .repo__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    color: var(--fg-dim);
    font-size: var(--text-tiny);
  }

  .repo__lang {
    color: var(--success);
    font-weight: 700;
  }

  .repo__updated {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
