---
/**
 * Row of little color squares.
 * <ColorSwatches colors={["#ef4444", "#22c55e"]} label="PALETTE:" />
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  colors: string[];
  label?: string;
  /** Square size in px. */
  size?: number;
}

const { colors, label = "PALETTE:", size = 16, class: className, ...rest } = Astro.props;
---

<div class:list={["swatches", className]} {...rest}>
  {label && <span class="swatches__label">{label}</span>}
  {colors.map((color) => <span class="swatches__chip" style={`background-color: ${color}; --_size: ${size}px`} title={color} />)}
</div>

<style>
  .swatches {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--font);
  }

  .swatches__label {
    margin-right: var(--space-2);
    color: var(--fg-dim);
    font-size: var(--text-tiny);
  }

  .swatches__chip {
    display: inline-block;
    width: var(--_size);
    height: var(--_size);
    border: 1px solid rgba(55, 65, 81, 0.6);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
</style>
