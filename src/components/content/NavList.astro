---
/**
 * File-explorer style navigation.
 *
 * <NavList>
 *   <NavItem href="#about" num="1." meta="About Me" active>bio.txt</NavItem>
 *   <NavItem href="#skills" num="2.">skills.sh</NavItem>
 *   <NavItem num="3." dashed tone="pink" data-modal-open="radio">radio.sh</NavItem>
 * </NavList>
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"nav"> {
  label?: string;
}

const { label = "Sections", class: className, ...rest } = Astro.props;
---

<nav class:list={["nav", className]} aria-label={label} {...rest}>
  <slot />
</nav>

<style>
  .nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font);
    font-size: var(--text-xs);
  }
</style>
