---
/**
 * Detailed project / collaboration card.
 *
 * <ProjectCard
 *   title="Edge Cache Rewrite"
 *   badge="Open Source Org"
 *   meta={[{ label: "Partner", value: "Acme" }, { label: "Role", value: "Lead", tone: "success" }, { value: "2023 – now" }]}
 *   description="…"                  (or use the default slot)
 *   listTitle="Key Contributions:"
 *   items={["Cut p99 latency by 40%", "…"]}
 *   tags={["Rust", "WASM"]}
 *   link={{ href: "https://…", label: "View Project ↗" }}
 *   ascii={logoArt}
 * />
 */
import type { HTMLAttributes } from "astro/types";
import Card from "../surfaces/Card.astro";
import Badge from "../feedback/Badge.astro";
import AsciiBlock from "../surfaces/AsciiBlock.astro";
import { toneVar, type Tone } from "../../lib/tone";

interface Meta {
  label?: string;
  value: string;
  tone?: Tone;
}

interface Props extends HTMLAttributes<"article"> {
  title: string;
  icon?: string;
  badge?: string;
  ascii?: string;
  meta?: Meta[];
  description?: string;
  listTitle?: string;
  items?: string[];
  tags?: string[];
  link?: { href: string; label?: string };
}

const { title, icon, badge, ascii, meta = [], description, listTitle, items = [], tags = [], link, ...rest } = Astro.props;
---

<Card as="article" variant="inset" padding="lg" interactive {...rest}>
  <header class="project__head">
    <h3 class="project__title">
      {icon && <span aria-hidden="true">{icon}</span>}
      {title}
    </h3>
    {badge && <Badge variant="outline" uppercase>{badge}</Badge>}
  </header>

  {ascii && <AsciiBlock text={ascii} />}

  {
    meta.length > 0 && (
      <div class="project__meta">
        {meta.map((m, i) => (
          <>
            {i > 0 && <span class="project__sep" aria-hidden="true">|</span>}
            <span>
              {m.label && <span class="project__meta-label">{m.label}: </span>}
              <span class="project__meta-value" style={`color: ${toneVar(m.tone ?? (m.label ? "bright" : "dim"))}`}>
                {m.value}
              </span>
            </span>
          </>
        ))}
      </div>
    )
  }

  {description && <p class="project__desc">{description}</p>}
  <slot />

  {
    items.length > 0 && (
      <div class="project__list">
        {listTitle && <span class="project__list-title">{listTitle}</span>}
        <ul>
          {items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    )
  }

  {
    (tags.length > 0 || link) && (
      <footer class="project__foot">
        <div class="project__tags">
          {tags.map((t) => <Badge variant="muted">{t}</Badge>)}
        </div>
        {link && (
          <a class="project__link" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label ?? "View Project ↗"}
          </a>
        )}
      </footer>
    )
  }
</Card>

<style>
  .project__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .project__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--fg-bright);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .project__meta {
    font-size: var(--text-xs);
  }

  .project__sep {
    margin: 0 var(--space-2);
    color: var(--fg-dim);
  }

  .project__meta-label {
    color: var(--accent);
    font-weight: 700;
  }

  .project__meta-value {
    font-weight: 700;
  }

  .project__desc {
    margin: 0;
    color: var(--fg);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }

  .project__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-1);
  }

  .project__list-title {
    color: var(--fg-dim);
    font-size: var(--text-tiny);
    font-weight: 700;
    text-transform: uppercase;
  }

  .project__list ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    color: var(--fg);
    font-size: var(--text-xs);
    list-style-position: inside;
  }

  .project__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .project__link {
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
  }

  .project__link:hover {
    text-decoration: underline;
  }
</style>
