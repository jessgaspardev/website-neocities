---
/**
 * Goes inside <head>. It applies the visitor's saved theme before the
 * page paints.
 *
 * <head>
 *   <ThemeScript />            default theme: green
 *   <ThemeScript fallback="amber" />
 * </head>
 */
import { DEFAULT_THEME, THEME_STORAGE_KEY } from "../../lib/theme";

interface Props {
  fallback?: string;
}

const { fallback = DEFAULT_THEME } = Astro.props;
---

<script is:inline define:vars={{ key: THEME_STORAGE_KEY, fallback }}>
  try {
    document.documentElement.setAttribute("data-theme", localStorage.getItem(key) || fallback);
  } catch (e) {
    document.documentElement.setAttribute("data-theme", fallback);
  }
</script>
