---
/**
 * Block-character meter: "████████░░ 80%" drawn over a soft fill.
 * <AsciiMeter value={80} />
 * <AsciiMeter value={3} max={5} segments={5} showValue={false} />
 */
import type { HTMLAttributes } from "astro/types";
import { mergeStyle, toneVar, type Tone } from "../../lib/tone";

interface Props extends HTMLAttributes<"div"> {
  value: number;
  max?: number;
  segments?: number;
  showValue?: boolean;
  tone?: Tone;
  filledChar?: string;
  emptyChar?: string;
}

const {
  value,
  max = 100,
  segments = 10,
  showValue = true,
  tone = "dim",
  filledChar = "█",
  emptyChar = "░",
  class: className,
  style,
  ...rest
} = Astro.props;

const pct = Math.min(100, Math.max(0, Math.round((value / max) * 100)));
const filled = Math.round((pct / 100) * segments);
const bar = filledChar.repeat(filled) + emptyChar.repeat(segments - filled);
---

<div
  class:list={["meter", className]}
  style={mergeStyle(`--_pct: ${pct}%; --_fill: ${toneVar(tone)}`, style)}
  role="meter"
  aria-valuemin="0"
  aria-valuemax={max}
  aria-valuenow={value}
  {...rest}
>
  <div class="meter__fill"></div>
  <span class="meter__text" aria-hidden="true">{bar}{showValue && ` ${pct}%`}</span>
</div>

<style>
  .meter {
    position: relative;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 16px;
    padding: 0 4px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-card);
    font-family: var(--font);
  }

  .meter__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--_pct);
    background: var(--_fill);
    opacity: 0.4;
  }

  .meter__text {
    position: relative;
    color: var(--fg-bright);
    font-size: var(--text-tiny);
    white-space: nowrap;
  }
</style>
