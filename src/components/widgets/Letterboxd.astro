---
/**
 * Recently watched films from your Letterboxd diary, with rating, like and rewatch.
 * Fetched from your public Letterboxd RSS feed at build time, so it's plain
 * static HTML and only changes when the site is rebuilt.
 *
 *   <Letterboxd />
 *   <Letterboxd username="amandaseyfrieds" limit={5} />
 */
import type { HTMLAttributes } from "astro/types";
import Card from "../surfaces/Card.astro";
import StatusDot from "../feedback/StatusDot.astro";
import { fetchLetterboxdFilms } from "../../lib/letterboxd";

interface Props extends HTMLAttributes<"div"> {
  username?: string;
  /** How many films to show. */
  limit?: number;
}

const { username = "amandaseyfrieds", limit = 4, ...rest } = Astro.props;

const films = await fetchLetterboxdFilms(username, limit);

const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
const formatDate = (date: Date) =>
  `${String(date.getDate()).padStart(2, "0")} ${MONTHS[date.getMonth()]} ${date.getFullYear()}`;

const stars = (rating: number) =>
  "★".repeat(Math.floor(rating)) + (rating % 1 ? "½" : "") + "☆".repeat(5 - Math.ceil(rating));
---

<Card interactive="accent" class="films" {...rest}>
  <div class="films__head">
    <span class="films__state">
      <StatusDot />
      <span>LETTERBOXD</span>
    </span>
    <span class="films__tag">
      <span class="films__icon" aria-hidden="true">🎬</span>
      <span class="films__badge">DIARY</span>
    </span>
  </div>

  {films.length === 0 && <div class="films__empty">No recent films.</div>}

  {
    films.map((film) => (
      <div class="films__body">
        <div class="films__art">
          <span aria-hidden="true">🎞️</span>
          {film.poster && <img src={film.poster} alt="" loading="lazy" />}
        </div>
        <div class="films__text">
          <div class="films__label">
            {film.rewatch ? "REWATCHED" : "WATCHED"}
            {film.rating && (
              <span class="films__stars" aria-label={`${film.rating} out of 5 stars`}>
                {stars(film.rating)}
              </span>
            )}
            {film.liked && (
              <span class="films__like" aria-label="liked">
                ♥
              </span>
            )}
          </div>
          <a class="films__title" href={film.href} target="_blank" rel="noopener" title={film.title}>
            {film.title}
          </a>
          <div class="films__year">{film.year}</div>
          <time class="films__date" datetime={film.watched.toISOString()}>
            {formatDate(film.watched)}
          </time>
        </div>
      </div>
    ))
  }

  <div class="films__foot">
    <span>PROFILE:</span>
    <a class="films__link" href={`https://letterboxd.com/${username}/`} target="_blank" rel="noopener">letterboxd ↗</a>
  </div>
</Card>

<style>
  .films__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .films__state {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--fg-bright);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    white-space: nowrap;
  }

  .films__tag {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 6px;
  }

  .films__icon {
    display: inline-block;
    font-size: var(--text-sm);
    animation: films-bounce 1s infinite;
  }

  .films__badge {
    padding: 1px 4px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg-bright);
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
  }

  .films__empty {
    color: var(--fg-dim);
    font-size: var(--text-xs);
  }

  .films__body {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .films__art {
    position: relative;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 60px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg);
    font-size: var(--text-lg);
  }

  .films__art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .films__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .films__label,
  .films__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .films__label {
    color: var(--fg-dim);
    font-size: var(--text-tiny);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
  }

  .films__stars,
  .films__like {
    margin-left: 6px;
    color: var(--accent);
    letter-spacing: 0;
  }

  .films__title {
    color: var(--fg-bright);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .films__title:hover {
    text-decoration: underline;
  }

  .films__year {
    color: var(--fg);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .films__date {
    color: var(--accent);
    font-size: var(--text-tiny);
    font-variant-numeric: tabular-nums;
  }

  .films__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-1);
    border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    color: var(--fg-dim);
    font-size: var(--text-tiny);
    font-weight: 700;
  }

  .films__link {
    color: var(--accent);
  }

  @keyframes films-bounce {
    0%, 100% { transform: translateY(-25%); animation-timing-function: cubic-bezier(0.8, 0, 1, 1); }
    50% { transform: none; animation-timing-function: cubic-bezier(0, 0, 0.2, 1); }
  }
</style>
