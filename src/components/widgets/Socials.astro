---
import Button from "../controls/Button.astro";
import SectionHeader from "../surfaces/SectionHeader.astro";
import { PORTFOLIO_DATA } from "../../data/portfolio";
const { developer } = PORTFOLIO_DATA;
---

<SectionHeader size="sm" icon="📁" title="SOCIALS" meta="LINKS" />
<Button href={developer.neocities} target="_blank" block>Neocities Profile ↗</Button>
<Button href={developer.twitter} target="_blank" block>Twitter ↗</Button>
<Button href={developer.bluesky} target="_blank" block>Bluesky ↗</Button>
<Button href={developer.github} target="_blank" block>GitHub ↗</Button>
