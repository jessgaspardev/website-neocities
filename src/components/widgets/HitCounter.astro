---
interface Props {
  namespace?: string;
  counterKey?: string;
}

const { namespace = "jessgaspar.dev", counterKey = "hits" } = Astro.props;
---

<span class="hit-counter" data-hit-counter data-namespace={namespace} data-key={counterKey}>---</span>

<style>
  .hit-counter {
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  const API = "https://abacus.jasoncameron.dev";

  async function loadCounter(el: HTMLElement) {
    const { namespace = "", key = "" } = el.dataset;
    const storageKey = `hits:${namespace}/${key}`;

    try {
      const cached = sessionStorage.getItem(storageKey);
      if (cached) el.textContent = cached;
    } catch {}

    try {
      const res = await fetch(`${API}/hit/${encodeURIComponent(namespace)}/${encodeURIComponent(key)}`);
      if (!res.ok) throw new Error(String(res.status));
      const { value } = (await res.json()) as { value: number };
      const text = value.toLocaleString("en-US");
      el.textContent = text;
      try {
        sessionStorage.setItem(storageKey, text);
      } catch {}
    } catch {
      if (el.textContent === "---") el.textContent = "???";
    }
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-hit-counter]:not([data-loaded])").forEach((el) => {
      el.dataset.loaded = "";
      loadCounter(el);
    });
  }
  
  init();
  document.addEventListener("astro:page-load", init);
</script>
