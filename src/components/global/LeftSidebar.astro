---
import Navigation from "../global/Navigation.astro";
import Socials from "../sections/Socials.astro";
import { Image } from "astro:assets";
import palestine from "../../assets/blinkies/standwith.png";
import LinkMeButton from "../widgets/LinkMeButton.astro";
import Changelog from "../sections/Changelog.astro";
import Blinkies from "../sections/Blinkies.astro";
---

<aside class="left-sidebar">
  <div class="sidebar-title">Navigation</div>
  <Navigation />
  <Changelog />
  <Blinkies />


  <div class="sidebar-section">
    <div class="sidebar-title">Other Places</div>
    <Socials />
  </div>

  <div class="sidebar-section">
        <center><a href="https://hillhouse.neocities.org/journal/notes/palestine" target="_blank"><Image src={palestine} alt="Stand with Palestine" /></a></center>
  </div>


  <div class="sidebar-section">
    <div class="sidebar-title">Link me!</div>
    <LinkMeButton />
  </div>
</aside>
