---
import { Image } from "astro:assets";

const {image, title, description, link, year, image2, image3, image4} = Astro.props;
---

<div class="work-card">
    <div>
        <marquee behavior="scroll" direction="left" scrollamount="10">
            <Image src={image} alt={title} height={300} />
            <Image src={image2} alt={title} height={300} />
            <Image src={image3} alt={title} height={300} />
            <Image src={image4} alt={title} height={300} />
        </marquee>   
    </div> 
    <div>
        <h2>{title}</h2>
        <p>{description}</p>
        <a href=`${link}` target="_blank">Live Website</a>
        <p>Year: {year}</p>
    </div>
</div>

<style>
    .work-card {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
</style>